@model HospitalAppointmentSystem.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";
}

<div class="container mt-4">
    <h2>Patient Appointment Form</h2>

    <form asp-controller="Doctor"
          asp-action="Book"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="DoctorId" />

        <input type="hidden"
               asp-for="Specialization" />

        <div class="mb-3">
            <label asp-for="PatientName" class="form-label">
                Patient Name
            </label>
            <input asp-for="PatientName" class="form-control" />
            <span asp-validation-for="PatientName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Specialization</label>
            <input value="@Model.Specialization"
                   class="form-control"
                   readonly />
        </div>

        <div class="mb-3">
            <label asp-for="AppointmentDate" class="form-label">
                Appointment Date
            </label>
            <input asp-for="AppointmentDate"
                   type="date"
                   class="form-control" />
            <span asp-validation-for="AppointmentDate"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Reason" class="form-label">
                Reason for Appointment
            </label>
            <textarea asp-for="Reason"
                      class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-success">
            Submit Appointment
        </button>
    </form>
</div>